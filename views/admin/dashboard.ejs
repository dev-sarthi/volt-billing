<%- include('../partials/admin-header') %>

<div class="page-header">
  <h2><i data-lucide="layout-dashboard" width="32" height="32" style="color: var(--accent-blue); margin-right: 0.5rem;"></i> Dashboard Overview</h2>
</div>

<div class="bento-grid" style="margin-bottom: 2rem;">
  <div class="bento-card bento-stat">
    <div class="stat-card__label"><i data-lucide="file-spreadsheet" width="16" height="16"></i> Total Bills Generated</div>
    <div class="stat-card__value"><%= stats.totalBills %></div>
  </div>
  
  <div class="bento-card bento-stat">
    <div class="stat-card__label"><i data-lucide="zap" width="16" height="16"></i> Total Units Billed</div>
    <div class="stat-card__value"><%= stats.totalUnits %> <span style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);">units</span></div>
  </div>

  <div class="bento-card bento-stat" style="border-top: 4px solid var(--status-success);">
    <div class="stat-card__label"><i data-lucide="check-circle" width="16" height="16"></i> Paid Bills</div>
    <div class="stat-card__value" style="color: var(--status-success);"><%= stats.paidCount %></div>
    <div style="color: var(--status-success); margin-top: 0.75rem; font-weight: 600; font-size: 0.9rem;">
      Collected: ₹<%= stats.paidAmount %>
    </div>
  </div>
  
  <div class="bento-card bento-stat" style="border-top: 4px solid var(--status-warning);">
    <div class="stat-card__label"><i data-lucide="clock" width="16" height="16"></i> Unpaid Bills</div>
    <div class="stat-card__value" style="color: var(--status-warning);"><%= stats.unpaidCount %></div>
    <div style="color: var(--status-warning); margin-top: 0.75rem; font-weight: 600; font-size: 0.9rem;">
      Outstanding: ₹<%= stats.unpaidAmount %>
    </div>
  </div>
</div>

<div class="bento-grid">
  <div class="bento-card bento-wide">
    <div class="bento-card__title"><i data-lucide="bar-chart-3" width="20" height="20"></i> Top Consumers (By Billed Amount)</div>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Consumer ID</th>
            <th>Name</th>
            <th>Type</th>
            <th>Bills</th>
            <th>Total Amount</th>
          </tr>
        </thead>
        <tbody>
          <% if (!topConsumers || topConsumers.length === 0) { %>
            <tr>
              <td colspan="5" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                <i data-lucide="inbox" width="32" height="32" style="margin-bottom: 0.5rem; opacity: 0.5;"></i><br>
                No bills generated yet.
              </td>
            </tr>
          <% } else { %>
            <% topConsumers.forEach(consumer => { %>
              <tr>
                <td><strong><%= consumer.consumerId %></strong></td>
                <td><%= consumer.name %></td>
                <td>
                  <span class="badge badge--<%= consumer.connectionType === 'commercial' ? 'warning' : 'primary' %>" style="text-transform: capitalize; border: none; background: rgba(0,0,0,0.05); color: var(--text-main);">
                    <%= consumer.connectionType %>
                  </span>
                </td>
                <td><%= consumer.billsCount %></td>
                <td style="font-weight: 700; color: var(--text-main);">₹<%= consumer.totalAmountBilled %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="bento-card bento-side" style="border-top: 4px solid var(--status-danger);">
    <div class="bento-card__title"><i data-lucide="alert-triangle" width="20" height="20" style="color: var(--status-danger);"></i> Attention Required</div>
    <div class="stat-card__value" style="color: var(--status-danger); margin-top: 1rem;"><%= stats.overdueCount %></div>
    <div style="font-weight: 600; color: var(--text-muted); margin-top: 0.5rem;">Overdue Bills</div>
    <p style="margin-top: 1.5rem; font-size: 0.9rem; color: var(--text-muted);">
      These bills have passed their due date and require follow-up. They are included in the unpaid total.
    </p>
  </div>
</div>

<%- include('../partials/admin-footer') %>
