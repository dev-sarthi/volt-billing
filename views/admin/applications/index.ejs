<%- include('../../partials/admin-header') %>

<div class="page-header">
  <h2><i data-lucide="file-check-2" width="32" height="32" style="color: var(--accent-blue); margin-right: 0.5rem;"></i> Connection Applications</h2>
</div>

<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Applicant Name</th>
        <th>Email</th>
        <th>Type / Utility</th>
        <th>Status</th>
        <th style="text-align: right;">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (!applications || applications.length === 0) { %>
        <tr>
          <td colspan="6" class="empty-state" style="text-align: center; padding: 4rem 2rem; color: var(--text-muted);">
            <i data-lucide="inbox" width="48" height="48" style="margin-bottom: 1rem; opacity: 0.5;"></i><br>
            No applications found.
          </td>
        </tr>
      <% } else { %>
        <% applications.forEach(app => { %>
          <tr>
            <td>
              <div style="font-weight: 600;"><%= new Date(app.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
              <div style="font-size: 0.85rem; color: var(--text-muted);"><%= new Date(app.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></div>
            </td>
            <td><strong><%= app.applicantName %></strong></td>
            <td><a href="mailto:<%= app.email %>" style="color: var(--accent-blue); text-decoration: none;"><%= app.email %></a></td>
            <td>
              <div style="display: flex; gap: 0.5rem;">
                <span class="badge badge--<%= app.connectionType === 'commercial' ? 'warning' : 'primary' %>" style="border: none; background: rgba(0,0,0,0.05); color: var(--text-main);">
                  <%= app.connectionType %>
                </span>
                <span class="badge badge--<%= app.utilityType === 'water' ? 'info' : 'warning' %>" style="border: none; background: rgba(0,0,0,0.05); color: var(--text-main);">
                  <%= app.utilityType || 'electricity' %>
                </span>
              </div>
            </td>
            <td>
              <% if (app.status === 'pending') { %>
                <span class="badge badge--warning" style="border: none;"><i data-lucide="clock" width="12" height="12" style="margin-right: 0.25rem;"></i> Pending</span>
              <% } else if (app.status === 'approved') { %>
                <span class="badge badge--success" style="border: none;"><i data-lucide="check" width="12" height="12" style="margin-right: 0.25rem;"></i> Approved</span>
              <% } else { %>
                <span class="badge badge--danger" style="border: none;"><i data-lucide="x" width="12" height="12" style="margin-right: 0.25rem;"></i> Rejected</span>
              <% } %>
            </td>
            <td style="text-align: right;">
              <a href="/admin/applications/<%= app._id %>" class="btn btn--outline btn--sm">
                Review <i data-lucide="arrow-right" width="16" height="16"></i>
              </a>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('../../partials/admin-footer') %>
