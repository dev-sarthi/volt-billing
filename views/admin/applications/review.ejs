<%- include('../../partials/admin-header') %>

<div class="page-header">
  <h2><i data-lucide="file-text" width="32" height="32" style="color: var(--accent-blue); margin-right: 0.5rem;"></i> Review Application</h2>
  <a href="/admin/applications" class="btn btn--outline">
    <i data-lucide="arrow-left" width="16" height="16"></i> Back
  </a>
</div>

<div class="bento-card" style="max-width: 900px; margin: 0 auto;">
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem;">
    <div>
      <h3 style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
        <i data-lucide="user" width="20" height="20"></i> Applicant Details
      </h3>
      <div style="display: grid; gap: 1rem; font-size: 0.95rem;">
        <div><strong style="color: var(--text-muted);">Name:</strong> <br> <span style="font-weight: 600;"><%= application.applicantName %></span></div>
        <div><strong style="color: var(--text-muted);">Email:</strong> <br> <a href="mailto:<%= application.email %>" style="color: var(--accent-blue); text-decoration: none;"><%= application.email %></a></div>
        <div><strong style="color: var(--text-muted);">Phone:</strong> <br> <%= application.phone %></div>
        <div><strong style="color: var(--text-muted);">Address:</strong> <br> <%= application.address %></div>
        
        <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
          <span class="badge badge--<%= application.connectionType === 'commercial' ? 'warning' : 'primary' %>" style="border: none; background: rgba(0,0,0,0.05); color: var(--text-main);">
            <%= application.connectionType %>
          </span>
          <span class="badge badge--<%= application.utilityType === 'water' ? 'info' : 'warning' %>" style="border: none; background: rgba(0,0,0,0.05); color: var(--text-main);">
            <%= application.utilityType || 'electricity' %>
          </span>
        </div>

        <div><strong style="color: var(--text-muted);">Applied On:</strong> <br> <%= new Date(application.createdAt).toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></div>
        <div>
          <strong style="color: var(--text-muted);">Status:</strong> <br>
          <% if (application.status === 'pending') { %>
            <span class="badge badge--warning" style="border: none; margin-top: 0.25rem;"><i data-lucide="clock" width="12" height="12" style="margin-right: 0.25rem;"></i> Pending</span>
          <% } else if (application.status === 'approved') { %>
            <span class="badge badge--success" style="border: none; margin-top: 0.25rem;"><i data-lucide="check" width="12" height="12" style="margin-right: 0.25rem;"></i> Approved</span>
          <% } else { %>
            <span class="badge badge--danger" style="border: none; margin-top: 0.25rem;"><i data-lucide="x" width="12" height="12" style="margin-right: 0.25rem;"></i> Rejected</span>
          <% } %>
        </div>
      </div>
    </div>
    
    <div>
      <h3 style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
        <i data-lucide="paperclip" width="20" height="20"></i> Submitted Documents
      </h3>
      <% if (application.documents && application.documents.length > 0) { %>
        <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.75rem;">
          <% application.documents.forEach(doc => { %>
            <li>
              <a href="<%= doc.path %>" target="_blank" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; background: #f8fafc; border: 1px solid var(--border-color); border-radius: var(--radius-sm); color: var(--text-main); text-decoration: none; transition: var(--transition);">
                <i data-lucide="file" width="18" height="18" style="color: var(--text-muted);"></i>
                <span style="font-weight: 500;"><%= doc.originalName %></span>
              </a>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <div style="background: #f8fafc; border: 1px dashed var(--border-color); border-radius: var(--radius-sm); padding: 2rem; text-align: center; color: var(--text-muted);">
          <i data-lucide="file-x" width="32" height="32" style="margin-bottom: 0.5rem; opacity: 0.5;"></i>
          <p>No documents uploaded.</p>
        </div>
      <% } %>
    </div>
  </div>

  <% if (application.status === 'pending') { %>
    <div style="border-top: 1px solid var(--border-color); padding-top: 1.5rem; display: flex; gap: 1rem; justify-content: flex-end;">
      <form action="/admin/applications/<%= application._id %>/reject" method="POST">
        <button type="submit" class="btn btn--outline" style="color: var(--status-danger); border-color: var(--status-danger);" onclick="return confirm('Are you sure you want to reject this application?')">
          Reject <i data-lucide="x" width="16" height="16" style="margin-left: 0.25rem;"></i>
        </button>
      </form>
      <form action="/admin/applications/<%= application._id %>/approve" method="POST">
        <button type="submit" class="btn btn--primary" onclick="return confirm('Approve this application and create a user account?')">
          Approve & Create Account <i data-lucide="check" width="16" height="16" style="margin-left: 0.25rem;"></i>
        </button>
      </form>
    </div>
  <% } else { %>
    <div style="border-top: 1px solid var(--border-color); padding-top: 1.5rem; text-align: center; color: var(--text-muted);">
      <p>This application was <strong style="color: var(--<%= application.status === 'approved' ? 'status-success' : 'status-danger' %>); text-transform: uppercase;"><%= application.status %></strong>.</p>
    </div>
  <% } %>
</div>

<%- include('../../partials/admin-footer') %>
