<%- include('../../partials/admin-header') %>

<div class="page-header">
  <h2><i data-lucide="gauge" width="32" height="32" style="color: var(--accent-blue); margin-right: 0.5rem;"></i> All Meters</h2>
</div>

<!-- Inline add-meter form -->
<div class="bento-card" style="margin-bottom: 2rem;">
  <div class="bento-card__title"><i data-lucide="plus-circle" width="18" height="18"></i> Assign New Meter</div>
  <% if (availableConsumers.length > 0) { %>
    <form action="/admin/meters" method="POST" style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-end;">
      <div class="form-group" style="flex: 1; min-width: 200px; margin-bottom: 0;">
        <label for="meterNumber">Meter Number</label>
        <input type="text" id="meterNumber" name="meterNumber" placeholder="e.g. MTR-10045" required style="box-shadow: none;" />
      </div>
      <div class="form-group" style="flex: 2; min-width: 300px; margin-bottom: 0;">
        <label for="consumerId">Assign to Consumer</label>
        <select id="consumerId" name="consumerId" required style="box-shadow: none;">
          <option value="">Select consumer…</option>
          <% availableConsumers.forEach(c => { %>
            <option value="<%= c._id %>">
              <%= c.consumerId %> — <%= c.userId ? c.userId.name : 'Unknown' %>
            </option>
          <% }) %>
        </select>
      </div>
      <button type="submit" class="btn btn--primary">
        Add Meter <i data-lucide="plus" width="16" height="16"></i>
      </button>
    </form>
  <% } else { %>
    <div style="color: var(--text-muted); font-size: 0.95rem; display: flex; align-items: center; gap: 0.5rem; background: #f8fafc; padding: 1rem; border-radius: var(--radius-sm); border: 1px dashed var(--border-color);">
      <i data-lucide="check-circle" width="18" height="18" style="color: var(--status-success);"></i> All active consumers already have a meter assigned. Add a new consumer first.
    </div>
  <% } %>
</div>

<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th>Meter Number</th>
        <th>Consumer ID</th>
        <th>Consumer Name</th>
        <th>Utility</th>
        <th>Status</th>
        <th>Installed</th>
      </tr>
    </thead>
    <tbody>
      <% if (meters.length === 0) { %>
        <tr>
          <td colspan="6" class="empty-state" style="text-align: center; padding: 4rem 2rem; color: var(--text-muted);">
            <i data-lucide="inbox" width="48" height="48" style="margin-bottom: 1rem; opacity: 0.5;"></i><br>
            No meters found. Assign a meter above.
          </td>
        </tr>
      <% } else { %>
        <% meters.forEach(m => { %>
          <tr>
            <td style="font-family: monospace; font-weight: 600;"><%= m.meterNumber %></td>
            <td style="font-family: monospace;"><%= m.consumerId ? m.consumerId.consumerId : '—' %></td>
            <td style="font-weight: 600;"><%= m.consumerId && m.consumerId.userId ? m.consumerId.userId.name : '—' %></td>
            <td>
              <span class="badge badge--<%= m.utilityType === 'water' ? 'info' : 'warning' %>" style="border: none; background: rgba(0,0,0,0.05); color: var(--text-main);">
                <%= m.utilityType || 'electricity' %>
              </span>
            </td>
            <td>
              <span class="badge badge--<%= m.status === 'active' ? 'success' : (m.status === 'inactive' ? 'danger' : 'warning') %>" style="border: none;"><%= m.status %></span>
            </td>
            <td><%= m.installedDate ? new Date(m.installedDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—' %></td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('../../partials/admin-footer') %>
