<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Apply for Connection — VoltBilling</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/style.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
    @media(max-width: 600px) {
      .grid-2 {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body class="hero">
  <div class="apply-card">
    <div class="apply-header">
      <div style="display: flex; justify-content: center; margin-bottom: 1rem;">
        <div style="background: rgba(14, 165, 233, 0.1); padding: 0.75rem; border-radius: 50%; color: var(--accent-blue);">
          <i data-lucide="file-text" width="28" height="28"></i>
        </div>
      </div>
      <h1>Apply for New Connection</h1>
      <p>Submit your details and documents for review</p>
    </div>

    <%- include('../partials/flash') %>

    <form action="/apply" method="POST" enctype="multipart/form-data">
      <div class="form-group">
        <label for="applicantName">Full Name / Organization Name</label>
        <input type="text" id="applicantName" name="applicantName" required placeholder="e.g. John Doe">
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" required placeholder="you@example.com">
        </div>
        <div class="form-group">
          <label for="phone">Phone Number</label>
          <input type="tel" id="phone" name="phone" required placeholder="e.g. 1234567890">
        </div>
      </div>

      <div class="form-group">
        <label for="address">Installation Address</label>
        <input type="text" id="address" name="address" required placeholder="Full property address">
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label for="connectionType">Connection Type</label>
          <select id="connectionType" name="connectionType" required>
            <option value="domestic">Domestic</option>
            <option value="commercial">Commercial</option>
          </select>
        </div>
        <div class="form-group">
          <label for="utilityType">Utility Type</label>
          <select id="utilityType" name="utilityType" required>
            <option value="electricity">Electricity</option>
            <option value="water">Water</option>
          </select>
        </div>
      </div>

      <div class="form-group" style="margin-top: 1.5rem;">
        <label for="documents">Upload Documents (ID Proof, Property Papers)</label>
        <input type="file" id="documents" name="documents" multiple required accept=".pdf,.jpg,.jpeg,.png" style="padding: 0.5rem; cursor: pointer; border: 1px dashed var(--border-color); background: #f8fafc;">
        <small style="color: var(--text-muted); margin-top: 0.5rem; display: block; font-size: 0.85rem;">You can select multiple files. Max 5MB per file.</small>
      </div>

      <div style="margin-top: 2rem;">
        <button type="submit" class="btn btn--primary btn--block">
          Submit Application <i data-lucide="send" width="18" height="18"></i>
        </button>
      </div>
      
      <div style="text-align: center; margin-top: 1.5rem;">
        <a href="/" style="color: var(--text-muted); font-size: 0.9rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.25rem;">
          <i data-lucide="arrow-left" width="16" height="16"></i> Back to Home
        </a>
      </div>
    </form>
  </div>
  <script>
    lucide.createIcons();
  </script>
</body>
</html>
